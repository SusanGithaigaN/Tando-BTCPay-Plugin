@using BTCPayServer.Abstractions.Extensions
@using BTCPayServer.Abstractions.Models
@using BTCPayServer.Plugins.Tando.ViewModels
@model TandoSettingsViewModel
@{
    Layout = "_Layout";
    ViewData.SetLayoutModel(new LayoutModel(nameof(TandoBusinessPage.Settings), "Tando Business") { ActiveCategory = nameof(TandoBusinessPage) });
    ViewData["TandoTab"] = nameof(TandoBusinessPage.Settings);
    var secretPlaceholder = Model.HasTandoApiSecret ? "Saved. Leave empty to keep it" : null;
}

<div class="sticky-header">
    <h2>@ViewData["Title"]</h2>
    <a asp-action="Docs" class="btn btn-secondary" target="_blank" text-translate="true">API Docs</a>
</div>
<partial name="_StatusMessage" />
<partial name="_TandoTabs" />

<div class="row">
    <div class="col-xxl-constrain col-xl-10">
        <p class="text-secondary" text-translate="true">
            Tando reads merchant subscription plans from an Offering already configured. Pick the offering and the specific plan every merchant should be tied to.
        </p>

        @if (Model.Offerings.Any())
        {
            <form method="post">
                <div class="form-group mb-3">
                    <label asp-for="SubscriptionOfferingId" class="form-label" text-translate="true">Subscription offering</label>
                    <input type="hidden" name="Command" value="" />
                    <select asp-for="SubscriptionOfferingId" asp-items="Model.Offerings" class="form-select w-auto"
                            onchange="this.form.Command.value = 'refresh'; this.form.submit();">
                        <option value="" text-translate="true">Select an offering...</option>
                    </select>
                    <span asp-validation-for="SubscriptionOfferingId" class="text-danger"></span>
                </div>

                @if (Model.Plans.Any())
                {
                    <div class="form-group mb-3">
                        <label asp-for="SubscriptionPlanId" class="form-label" text-translate="true">Plan merchants are tied to</label>
                        <select asp-for="SubscriptionPlanId" asp-items="Model.Plans" class="form-select w-auto">
                            <option value="" text-translate="true">Select a plan...</option>
                        </select>
                        <span asp-validation-for="SubscriptionPlanId" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="FallbackSubscriptionPlanId" class="form-label" text-translate="true">Fallback plan (optional)</label>
                        <select asp-for="FallbackSubscriptionPlanId" asp-items="Model.Plans" class="form-select w-auto">
                            <option value="" text-translate="true">None</option>
                        </select>
                        <span asp-validation-for="FallbackSubscriptionPlanId" class="text-danger"></span>
                    </div>
                }
                else if (!string.IsNullOrEmpty(Model.SubscriptionOfferingId))
                {
                    <div class="alert alert-warning" role="alert" text-translate="true">The selected offering has no active plans yet. Add a plan to continue.</div>
                }
                <h4 class="mt-5 mb-3" text-translate="true">Tando payouts - split payments</h4>
                <div class="form-group mb-3">
                    <label asp-for="TandoApiBaseUrl" class="form-label" text-translate="true">Tando API address</label>
                    <input asp-for="TandoApiBaseUrl" class="form-control" placeholder="https://api.tando.to" />
                    <span asp-validation-for="TandoApiBaseUrl" class="text-danger"></span>
                    <div class="form-text" text-translate="true">Clear the address and key ID to turn Tando payouts off.</div>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="TandoApiKeyId" class="form-label" text-translate="true">Key ID</label>
                    <input asp-for="TandoApiKeyId" class="form-control" autocomplete="off" />
                    <span asp-validation-for="TandoApiKeyId" class="text-danger"></span>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="TandoApiSecret" class="form-label" text-translate="true">Secret</label>
                    <input asp-for="TandoApiSecret" type="password" autocomplete="new-password" class="form-control" placeholder="@secretPlaceholder" />
                    <span asp-validation-for="TandoApiSecret" class="text-danger"></span>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="MaxPayoutAmount" class="form-label" text-translate="true">Maximum payout per sale (KES)</label>
                    <input asp-for="MaxPayoutAmount" type="number" min="0" step="0.01" class="form-control" />
                    <span asp-validation-for="MaxPayoutAmount" class="text-danger"></span>
                    <div class="form-text" text-translate="true">
                        A split whose M-Pesa portion is above this is recorded but not paid out, so the Tando team can review it. Leave empty for no limit.
                    </div>
                </div>

                <button id="page-primary" type="submit" class="btn btn-primary" text-translate="true">Save</button>
            </form>
        }
        else
        {
            <div class="alert alert-warning" role="alert" text-translate="true">
                No subscription offerings exist yet. Create one first, then come back here to select it.
            </div>
            @if (Model.CreateOfferingUrl is not null)
            {
                <a href="@Model.CreateOfferingUrl" class="btn btn-primary" text-translate="true">Create a subscription offering</a>
            }
            else
            {
                <p class="text-secondary" text-translate="true">
                    Go to any store's Settings &gt; Offerings page to create one, then come back here.
                </p>
            }
        }
    </div>
</div>