@using BTCPayServer.Abstractions.Extensions
@using BTCPayServer.Abstractions.Models
@using BTCPayServer.Plugins.Tando.ViewModels
@model TandoStoresViewModel
@{
    Layout = "_Layout";
    ViewData.SetLayoutModel(new LayoutModel(nameof(TandoBusinessPage.Stores), "Tando Business") { ActiveCategory = nameof(TandoBusinessPage) });
    ViewData["TandoTab"] = nameof(TandoBusinessPage.Stores);
}

<div class="sticky-header">
    <h2>@ViewData["Title"]</h2>
</div>
<partial name="_StatusMessage" />
<partial name="_TandoTabs" />

<form method="get" class="d-flex gap-2 mb-3" style="max-width: 24rem">
    <input name="search" value="@Model.Search" class="form-control" placeholder="Search by phone number" />
    <button type="submit" class="btn btn-secondary" text-translate="true">Search</button>
</form>

@if (!Model.Stores.Any())
{
    <p class="text-secondary" text-translate="true">No merchant stores yet.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th text-translate="true">Phone</th>
                    <th text-translate="true">Owner</th>
                    <th text-translate="true">Staff</th>
                    <th text-translate="true">Subscription</th>
                    <th text-translate="true">Next payment</th>
                    <th text-translate="true">M-Pesa share</th>
                    <th text-translate="true">M-Pesa destination</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var store in Model.Stores)
                {
                    <tr>
                        <td>@store.Phone</td>
                        <td>@store.OwnerEmail</td>
                        <td>@store.Employees</td>
                        <td>
                            <span class="badge @(store.Active ? "bg-success" : "bg-danger")">@(store.Phase ?? "None")</span>
                        </td>
                        <td>@(store.NextPaymentDue?.ToString("yyyy-MM-dd") ?? "")</td>
                        <td>@(string.IsNullOrEmpty(store.SplitPercent) ? "0" : store.SplitPercent)%</td>
                        <td>@(store.Destination is null ? "" : $"{store.DestinationType}: {store.Destination}")</td>
                        <td class="text-end">
                            <a href="~/stores/@store.StoreId/" text-translate="true">Open store</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="d-flex gap-2">
        @if (Model.Skip > 0)
        {
            <a class="btn btn-secondary" asp-action="Stores" asp-route-search="@Model.Search" asp-route-skip="@Math.Max(0, Model.Skip - Model.Take)" text-translate="true">Previous</a>
        }
        @if (Model.HasMore)
        {
            <a class="btn btn-secondary" asp-action="Stores" asp-route-search="@Model.Search" asp-route-skip="@(Model.Skip + Model.Take)" text-translate="true">Next</a>
        }
    </div>
}
