          "mode": "raw",
          "raw": "{\n  \"amountKes\": 100,\n  \"destination\": \"254702345678\",\n  \"collection\": \"Succeeded\",\n  \"disbursement\": \"Pending\",\n  \"deliver\": true\n}",
