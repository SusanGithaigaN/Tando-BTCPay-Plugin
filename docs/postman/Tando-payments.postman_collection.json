{
  "info": {
    "name": "Tando shared KES payment workflow",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Explicit Development payment mock required. Uses a real local BTCPay store and durable ledger. Set a fresh orderId for each collection run."
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "Authorization",
        "type": "string"
      },
      {
        "key": "value",
        "value": "token {{apiKey}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:14142"
    },
    {
      "key": "apiKey",
      "value": ""
    },
    {
      "key": "storeId",
      "value": ""
    },
    {
      "key": "orderId",
      "value": "postman-001"
    }
  ],
  "item": [
    {
      "name": "Provider status",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/plugins/api/tando/stores/{{storeId}}/mpesa/status",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"provider\", () => pm.expect(pm.response.json()[\"provider\"]).to.eql(\"Mock\"));",
              "pm.test(\"ready\", () => pm.expect(pm.response.json()[\"ready\"]).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "Save test merchant destination",
      "request": {
        "method": "PUT",
        "url": "{{baseUrl}}/plugins/api/tando/stores/{{storeId}}/mpesa/settings",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"destinationType\": 0,\n  \"destination\": \"254702345678\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Initiate",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/plugins/api/tando/stores/{{storeId}}/mpesa/pay",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerPhone\": \"0701234567\",\n  \"amountKes\": 100,\n  \"orderId\": \"{{orderId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"collection\", () => pm.expect(pm.response.json()[\"collection\"]).to.eql(\"Pending\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Duplicate initiation",
